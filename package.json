{
  "name": "@ste5an/garmin-connect-mcp",
  "version": "2.0.0",
  "description": "Garmin Connect MCP server on the official Garmin Personal API: sleep, recovery, HRV, activities and trends for your AI assistant",
  "type": "module",
  "bin": {
    "garmin-connect-mcp": "./build/cli.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node build/cli.js serve",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "garmin",
    "garmin-connect",
    "mcp",
    "model-context-protocol",
    "fitness",
    "health",
    "claude"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "axios": "^1.7.9",
    "axios-cookiejar-support": "^5.0.5",
    "oauth-1.0a": "^2.2.6",
    "tough-cookie": "^5.1.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/tough-cookie": "^4.0.5",
    "dotenv": "^17.3.1",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3",
    "vitest": "^4.0.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ste5an/garmin-connect-mcp.git"
  },
  "author": "Stepan Papazian",
  "engines": {
    "node": ">=20"
  }
}
